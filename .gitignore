# -------------------------
# Servisio - Git Ignore File
# -------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
ENV/
env/
.venv/

# Local configuration
instance/
config.pyc
*.env
*.ini

# SQLite database files
*.db
*.sqlite3

# Logs and caches
*.log
*.pot
*.pyc
*.pyo
*.pyd
*.pid
*.gz
.cache/
.pytest_cache/

# Compiled C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# IDE / editor settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS-specific files
.DS_Store
Thumbs.db

# Render / Deployment artifacts
*.bak
*.swp
*.tmp
logs/
